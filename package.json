{
  "name": "kitty-netlify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kitty group buying: Vendor Connect marketplace with decentralized checkout redirection, on Netlify",
  "scripts": {
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit",
